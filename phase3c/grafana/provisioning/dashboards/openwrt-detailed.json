    {"datasource":{"type":"prometheus","uid":""},"fieldConfig":{"defaults":{"unit":"short","decimals":0},"overrides":[{"matcher":{"id":"byName","options":"eth0"},"properties":[{"id":"displayName","value":"WAN (eth0)"}]},{"matcher":{"id":"byName","options":"eth1"},"properties":[{"id":"displayName","value":"LAN port (eth1)"}]},{"matcher":{"id":"byName","options":"map-mape_auto"},"properties":[{"id":"displayName","value":"WAN IPv4 / MAP-E (map-mape_auto)"}]},{"matcher":{"id":"byName","options":"br-lan"},"properties":[{"id":"displayName","value":"LAN bridge (br-lan)"}]}]},"gridPos":{"h":8,"w":8,"x":0,"y":41},"id":12,"targets":[{"expr":"node_network_carrier{device=~\"eth0|eth1|map-mape_auto|br-lan\"}","legendFormat":"{{device}}","refId":"A"}],"title":"Interface carrier (1 = up)","type":"stat","description":"ONU uplink eth0 carries native IPv6 and encapsulated MAP-E traffic; map-mape_auto is the IPv4 WAN tunnel. LAN port eth1 and bridge br-lan overlap. Do not sum these interface rates. Link speed and carrier-down events describe physical NICs only."},
    {"datasource":{"type":"prometheus","uid":""},"fieldConfig":{"defaults":{"unit":"short","decimals":0},"overrides":[{"matcher":{"id":"byName","options":"eth0"},"properties":[{"id":"displayName","value":"WAN (eth0)"}]},{"matcher":{"id":"byName","options":"eth1"},"properties":[{"id":"displayName","value":"LAN port (eth1)"}]}]},"gridPos":{"h":8,"w":8,"x":8,"y":41},"id":13,"targets":[{"expr":"increase(node_network_carrier_down_changes_total{device=~\"eth0|eth1\"}[24h])","legendFormat":"{{device}}","refId":"A"}],"title":"Carrier-down events (24h)","type":"stat","description":"ONU uplink eth0 carries native IPv6 and encapsulated MAP-E traffic; map-mape_auto is the IPv4 WAN tunnel. LAN port eth1 and bridge br-lan overlap. Do not sum these interface rates. Link speed and carrier-down events describe physical NICs only."},
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 }, "overrides": [] }, "gridPos":{"h":8,"w":8,"x":16,"y":41}, "id": 14, "targets": [{ "expr": "100 * node_filefd_allocated / node_filefd_maximum", "refId": "A" }], "title": "File descriptors used", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }, "gridPos":{"h":8,"w":12,"x":0,"y":49}, "id": 15, "targets": [{ "expr": "node_entropy_available_bits", "refId": "A" }], "title": "Available entropy", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }, "gridPos":{"h":8,"w":12,"x":12,"y":49}, "id": 16, "targets": [{ "expr": "min(node_scrape_collector_success)", "refId": "A" }, { "expr": "up{job=\"openwrt\"}", "refId": "B" }], "title": "Exporter / scrape health (1 = healthy)", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 0, "showPoints": "always", "pointSize": 5, "spanNulls": false, "stacking": { "mode": "none", "group": "A" } } }, "overrides": [] }, "gridPos":{"h":10,"w":24,"x":0,"y":57}, "id": 17, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }, "targets": [{ "expr": "router_lan_active_devices", "legendFormat": "devices", "refId": "A" }], "title": "Active IPv4 devices on DS57U LAN", "description": "Unique devices that answered a fresh ARP probe during the exporter scrape. IPv6-only devices and clients with neither a DHCP lease nor a remembered IPv4 neighbor address are not counted.", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 0, "showPoints": "always", "pointSize": 5, "spanNulls": false, "stacking": { "mode": "none", "group": "A" } } }, "overrides": [] }, "gridPos":{"h":10,"w":24,"x":0,"y":67}, "id": 18, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }, "targets": [{ "expr": "node_nf_conntrack_entries", "legendFormat": "connections", "refId": "A" }], "title": "Active connections through router", "description": "Active conntrack entries over time on the DS57U. This counts tracked network flows, not distinct devices or application sessions; app-specific connection counts are not available from this metric.", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "ms", "decimals": 1, "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 0, "showPoints": "always", "pointSize": 5, "spanNulls": false, "stacking": { "mode": "none", "group": "A" } } }, "overrides": [] }, "gridPos":{"h":10,"w":12,"x":0,"y":77}, "id": 19, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }, "targets": [{ "expr": "router_wan_probe_rtt_seconds * 1000", "legendFormat": "{{target}} average RTT", "refId": "A" }], "title": "WAN probe latency", "description": "Router-originated ICMP probe to 1.1.1.1: three packets every 30-second exporter scrape. It indicates reachability and latency to this one target, not application or line-rate performance.", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 0, "showPoints": "always", "pointSize": 5, "spanNulls": false, "stacking": { "mode": "none", "group": "A" } } }, "overrides": [] }, "gridPos":{"h":10,"w":12,"x":12,"y":77}, "id": 20, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }, "targets": [{ "expr": "router_wan_probe_packet_loss_ratio * 100", "legendFormat": "{{target}} packet loss", "refId": "A" }], "title": "WAN probe packet loss", "description": "Packet loss from the same three-packet router-originated ICMP probe. A 100% loss sample also produces probe success = 0; ICMP treatment by the target or path can differ from application traffic.", "type": "timeseries" },
    {"datasource":{"type":"prometheus","uid":""},"fieldConfig":{"defaults":{"unit":"Mbps","decimals":1,"custom":{"drawStyle":"bars","lineInterpolation":"linear","lineWidth":1,"fillOpacity":50,"showPoints":"never","pointSize":5,"spanNulls":false,"stacking":{"mode":"none","group":"A"}}},"overrides":[]},"gridPos":{"h":10,"w":12,"x":0,"y":87},"id":21,"options":{"legend":{"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"single","sort":"none"}},"targets":[{"expr":"topk(10, sum by (device) (rate(router_lan_device_traffic_bytes_total[5m]))) * 8 / 1000000","legendFormat":"{{device}}","refId":"A"}],"title":"Top 10 LAN IPv4 devices by sampled traffic (5 minutes)","description":"Top ten LAN IPv4 source addresses by five-minute rate from sampled conntrack byte counters. The collector counts bytes only while a flow is visible at a 30-second scrape, so short flows entirely between scrapes can be missed. IP addresses are device identifiers; no names, MAC addresses, payloads, DNS queries, or application labels are stored.","type":"timeseries"},
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 50, "showPoints": "never", "pointSize": 5, "spanNulls": false, "stacking": { "mode": "none", "group": "A" } } }, "overrides": [] }, "gridPos":{"h":10,"w":12,"x":12,"y":87}, "id": 22, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }, "targets": [{ "expr": "topk(10, router_lan_device_active_connections)", "legendFormat": "{{device}}", "refId": "A" }], "title": "Top 10 LAN IPv4 devices by active connections", "description": "Top ten LAN IPv4 source addresses by current conntrack-flow count. A connection is a tracked network flow, not a distinct application session; encrypted traffic is not classified. IP addresses are device identifiers and no names, MAC addresses, payloads, DNS queries, or application labels are stored.", "type": "timeseries" }
