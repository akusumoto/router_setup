{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] }, "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 }, "id": 1, "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A" }], "title": "CPU busy (5 minutes)", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] }, "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 }, "id": 2, "targets": [{ "expr": "node_load1", "refId": "A" }, { "expr": "node_load5", "refId": "B" }, { "expr": "node_load15", "refId": "C" }], "title": "Load averages (1 / 5 / 15 min)", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] }, "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 }, "id": 3, "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" }], "title": "Memory used", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] }, "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 }, "id": 4, "targets": [{ "expr": "node_memory_MemAvailable_bytes", "refId": "A" }], "title": "Available memory", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 }, "overrides": [] }, "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 }, "id": 5, "targets": [{ "expr": "100 * node_nf_conntrack_entries / node_nf_conntrack_entries_limit", "refId": "A" }], "title": "Conntrack table used", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }, "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 }, "id": 6, "targets": [{ "expr": "node_procs_running_total", "legendFormat": "running", "refId": "A" }, { "expr": "node_procs_blocked_total", "legendFormat": "blocked", "refId": "B" }], "title": "Processes", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] }, "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 }, "id": 7, "targets": [{ "expr": "time() - node_boot_time_seconds", "refId": "A" }], "title": "Uptime", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }, "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 }, "id": 8, "targets": [{ "expr": "rate(node_network_receive_bytes_total{device=~\"eth0|eth1|br-lan\"}[5m])", "legendFormat": "{{device}} RX", "refId": "A" }, { "expr": "rate(node_network_transmit_bytes_total{device=~\"eth0|eth1|br-lan\"}[5m])", "legendFormat": "{{device}} TX", "refId": "B" }], "title": "Interface traffic", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] }, "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 }, "id": 9, "targets": [{ "expr": "rate(node_network_receive_packets_total{device=~\"eth0|eth1|br-lan\"}[5m])", "legendFormat": "{{device}} RX", "refId": "A" }, { "expr": "rate(node_network_transmit_packets_total{device=~\"eth0|eth1|br-lan\"}[5m])", "legendFormat": "{{device}} TX", "refId": "B" }], "title": "Interface packet rate", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "gridPos": { "h": 10, "w": 12, "x": 0, "y": 24 }, "id": 10, "targets": [{ "expr": "rate(node_network_receive_errs_total{device=~\"eth0|eth1|br-lan\"}[5m])", "legendFormat": "{{device}} RX errors", "refId": "A" }, { "expr": "rate(node_network_transmit_errs_total{device=~\"eth0|eth1|br-lan\"}[5m])", "legendFormat": "{{device}} TX errors", "refId": "B" }, { "expr": "rate(node_network_receive_drop_total{device=~\"eth0|eth1|br-lan\"}[5m])", "legendFormat": "{{device}} RX drops", "refId": "C" }, { "expr": "rate(node_network_transmit_drop_total{device=~\"eth0|eth1|br-lan\"}[5m])", "legendFormat": "{{device}} TX drops", "refId": "D" }], "title": "Interface errors and drops", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "Mbps" }, "overrides": [] }, "gridPos": { "h": 10, "w": 12, "x": 12, "y": 24 }, "id": 11, "targets": [{ "expr": "node_network_speed_bytes{device=~\"eth0|eth1|br-lan\"} * 8 / 1000000", "legendFormat": "{{device}}", "refId": "A" }], "title": "Negotiated interface speed (Mb/s)", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 }, "id": 12, "targets": [{ "expr": "node_network_carrier{device=~\"eth0|eth1|br-lan\"}", "legendFormat": "{{device}}", "refId": "A" }], "title": "Interface carrier (1 = up)", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }, "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 }, "id": 13, "targets": [{ "expr": "increase(node_network_carrier_down_changes_total{device=~\"eth0|eth1|br-lan\"}[24h])", "legendFormat": "{{device}}", "refId": "A" }], "title": "Carrier-down events (24h)", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 }, "overrides": [] }, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 }, "id": 14, "targets": [{ "expr": "100 * node_filefd_allocated / node_filefd_maximum", "refId": "A" }], "title": "File descriptors used", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 }, "id": 15, "targets": [{ "expr": "node_entropy_available_bits", "refId": "A" }], "title": "Available entropy", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 }, "id": 16, "targets": [{ "expr": "min(node_scrape_collector_success)", "refId": "A" }, { "expr": "up{job=\"openwrt\"}", "refId": "B" }], "title": "Exporter / scrape health (1 = healthy)", "type": "stat" }
  ],
  "schemaVersion": 41,
