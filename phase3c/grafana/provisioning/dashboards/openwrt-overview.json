      "id": 3,
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device=~\"eth0|map-mape_auto|br-lan\"}[5m])",
          "legendFormat": "{{device}} RX",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device=~\"eth0|map-mape_auto|br-lan\"}[5m])",
          "legendFormat": "{{device}} TX",
          "refId": "B"
        }
      ],
      "title": "WAN and LAN traffic",
      "type": "timeseries",
      "description": "ONU uplink eth0 carries native IPv6 and encapsulated MAP-E traffic; map-mape_auto is the IPv4 WAN tunnel. LAN port eth1 and bridge br-lan overlap. Do not sum these interface rates. Link speed and carrier-down events describe physical NICs only."
